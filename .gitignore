# ============================================
# 录音转写服务 — 根目录 .gitignore
#
# 注意:
#   - .env.example 必须提交（这是模板，登录评审靠它）
#   - .env 必须忽略（真实凭据）
#   - SQLite 文件落在 backend/data/，本地开发产生，忽略
#   - uploads/ 是用户上传的音频，忽略
# ============================================

# ----- Python 字节码与依赖 -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pyc

# ----- 虚拟环境 -----
.venv/
venv/
env/
.ENV

# ----- 环境变量（真实凭据，禁止提交） -----
# 注意：.env.example 必须保留并提交，它是配置模板
.env
.env.*
!.env.example

# ----- 运行时产物 -----
uploads/
logs/
*.log
data/
*.db
*.sqlite
*.sqlite3

# ----- 测试产物 -----
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ----- IDE / 编辑器 -----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- 类型 / 构建 -----
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg
