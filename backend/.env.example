# ============================================
# 服务基础配置
# ============================================
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ============================================
# 数据库（必填，按环境二选一）
#
# 格式 A（Docker / 生产）：MySQL 异步驱动
#   mysql+aiomysql://<user>:<password>@<host>:3306/<dbname>
#
# 格式 B（无 Docker / 本地开发）：SQLite 异步驱动
#   sqlite+aiosqlite:///./data/recording.db
#
# 【Docker Compose 用户】
# DATABASE_URL 会被 docker-compose.yml 中的环境变量自动覆盖，
# 这里填什么都会被忽略，无需手动修改！
# ============================================
DATABASE_URL=mysql+aiomysql://<USER>:<PASSWORD>@127.0.0.1:3306/<DBNAME>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# 文件存储
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ============================================
# DeepSeek LLM（必填）
# 申请地址: https://platform.deepseek.com/
#
# ⚠️ 本文件是 .env.example，仅作模板占位
# 真实 API Key 必须放在 backend/.env（且 .env 已被 git 忽略）
# ============================================
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# ============================================
# 异步流水线
# ============================================
MAX_CONCURRENT_TASKS=3
MOCK_TRANSCRIBE_MIN_SEC=5
MOCK_TRANSCRIBE_MAX_SEC=15
MOCK_TRANSCRIBE_FAIL_RATE=0.2

# ============================================
# 日志
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
